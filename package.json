{
  "name": "mons-dot-link",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-bubblegum": "^5.1.0",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@mons/shared": "file:cloud/functions/shared",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@spruceid/siwe-parser": "3.0.0",
    "bs58": "^6.0.0",
    "ethers": "^6.17.0",
    "firebase": "^12.18.0",
    "glicko2": "^1.2.2",
    "jose": "^6.2.10",
    "mons-rules": "0.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "styled-components": "^6.5.3",
    "tweetnacl": "^1.0.3"
  },
  "scripts": {
    "start": "vite",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:nft-client": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/nftClient.test.mjs",
    "test:client": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:client",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "types:api": "wrangler types cloud/workers/api/worker-configuration.d.ts --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "types:api:check": "wrangler types cloud/workers/api/worker-configuration.d.ts --check --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "format:check:api": "prettier --check \"cloud/workers/api/{src,test,runtime}/**/*.ts\" cloud/workers/api/vitest.config.ts cloud/workers/api/wrangler.jsonc --ignore-unknown",
    "lint:api": "eslint \"cloud/workers/api/{src,test,runtime}/**/*.ts\" cloud/workers/api/vitest.config.ts",
    "typecheck:api": "tsc --noEmit -p cloud/workers/api/tsconfig.json",
    "test:api": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test cloud/workers/api/test/*.test.ts",
    "test:api:runtime": "vitest run --config cloud/workers/api/vitest.config.ts",
    "dry-run:api": "wrangler versions upload --dry-run --strict --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "check:api:core": "npm run lint:api && npm run typecheck:api && npm run test:api && npm run test:api:runtime && npm run types:api:check && npm run dry-run:api",
    "check:api": "npm run format:check:api && npm run check:api:core",
    "upload:api": "wrangler versions upload --strict --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "promote:api": "wrangler versions deploy --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env --percentage 100 --yes",
    "deploy:api:triggers": "wrangler triggers deploy --config cloud/workers/api/wrangler.jsonc --env-file cloud/workers/api/release.env",
    "smoke:api": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-cloudflare-api.ts",
    "migrate:telegram-d1": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-telegram-delivery.ts",
    "manage:profile-canonical": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/manage-profile-canonical.ts",
    "manage:event-prize-withdrawals": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/manage-event-prize-withdrawals.ts",
    "format:check:tooling": "prettier --check \"scripts/**/*.{ts,md}\" \"cloud/admin/**/*.js\" README.md cloud/README.md eslint.config.mjs package.json --ignore-unknown",
    "lint:tooling": "eslint \"scripts/**/*.ts\" \"cloud/admin/**/*.js\"",
    "typecheck:tooling": "tsc --noEmit -p scripts/tsconfig.json",
    "test:tooling": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/*.test.ts",
    "test:database-rules": "firebase emulators:exec --only database --project demo-mons-link-rules --config cloud/firebase.json \"node --test cloud/tests/databaseRules.emulator.test.cjs\"",
    "check:tooling:core": "npm run lint:tooling && npm run typecheck:tooling && npm run test:tooling",
    "check:tooling": "npm run format:check:tooling && npm run check:tooling:core",
    "check:all": "npm run format:check && npm run check && npm run check:api:core && npm run check:tooling:core && npm run test:database-rules && npm --prefix cloud/functions test",
    "announceEventPrizes": "node cloud/admin/announceEventPrizes.js",
    "recover:telegram": "node cloud/admin/recoverTelegramDelivery.js",
    "repo-clean": "bash scripts/repo-clean.sh",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "prepare:firebase": "npm --prefix cloud/functions ci && npm --prefix cloud/functions test",
    "deploy:firebase": "npm run prepare:firebase && node --experimental-strip-types scripts/deploy-firebase.ts",
    "deploy": "node --experimental-strip-types scripts/deploy-cloudflare.ts",
    "latest:root": "npx --yes npm-check-updates@latest -u --peer && npm install",
    "latest:functions": "npx --yes npm-check-updates@latest -u --peer --packageFile cloud/functions/package.json && npm install --prefix cloud/functions",
    "latest:admin": "npx --yes npm-check-updates@latest -u --peer --packageFile cloud/admin/package.json && npm install --prefix cloud/admin",
    "latest": "npm run latest:root && npm run latest:functions && npm run latest:admin"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "confusing-browser-globals": "^1.0.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "15.28.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "ethjs-unit": {
      "bn.js": "4.12.3"
    },
    "number-to-bn": {
      "bn.js": "4.12.3"
    }
  }
}
