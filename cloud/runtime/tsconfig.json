{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "moduleDetection": "force",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@mons/shared/*": ["./src/shared/*.ts"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts"]
}
