rules_version = '2';
service cloud.firestore {
  function validLeaderboardCustom(custom) {
    return custom is map
      && (!custom.keys().hasAny(["aura"])
        || custom.aura == null
        || (custom.aura is string && custom.aura.size() <= 32))
      && (!custom.keys().hasAny(["emoji"])
        || custom.emoji == null
        || custom.emoji is int
        || (custom.emoji is string && custom.emoji.size() <= 16));
  }

  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.logins != null
        && resource.data.logins.hasAll([request.auth.uid])
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["custom"])
        && validLeaderboardCustom(request.resource.data.custom);
    }
    match /users/{userId}/games/{inviteId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(userId)).data.logins != null
        && get(/databases/$(database)/documents/users/$(userId)).data.logins.hasAll([request.auth.uid]);
      allow write: if false;
    }
  }
}
